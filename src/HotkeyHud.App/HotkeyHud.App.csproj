<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HotkeyHud.Core\HotkeyHud.Core.csproj" />
  </ItemGroup>

  <!-- 应用档案随 exe 一起输出，运行时从 BaseDirectory\Data\apps 读取 -->
  <ItemGroup>
    <Content Include="Data\apps\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 仅用于 OverlayForm.CopyToDib 的逐行像素拷贝（见该处注释） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- §6 v1.4：Per-Monitor V2。SystemAware 下副屏会被系统虚拟化，字会糊 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 版本号写进程序集：用户报问题时能直接说版本（托盘 tooltip 也显示） -->
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>HotkeyHud</Product>
  </PropertyGroup>

</Project>