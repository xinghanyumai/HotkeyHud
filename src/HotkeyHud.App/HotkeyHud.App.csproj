<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HotkeyHud.Core\HotkeyHud.Core.csproj" />
  </ItemGroup>

  <!-- 应用档案随 exe 一起输出，运行时从 BaseDirectory\Data\apps 读取 -->
  <ItemGroup>
    <Content Include="Data\apps\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 仅用于 OverlayForm.CopyToDib 的逐行像素拷贝（见该处注释） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>